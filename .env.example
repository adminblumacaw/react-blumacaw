# Copy to .env for local development.
# In CI these would be injected from GitHub Actions secrets
# (see .github/workflows/firebase-deploy.yml).

# logo.dev token — used at runtime by LogoBar.tsx and Reviews.tsx to fetch
# brand logos by domain. Without it, those brands fall back to initials badges.
VITE_LOVABLE_CONNECTOR_LOGO_DEV_API_KEY="your-logo-dev-token"

# Supabase public/anon config. Currently UNUSED — nothing imports the client,
# so Vite tree-shakes it and the bundle is identical with or without these.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

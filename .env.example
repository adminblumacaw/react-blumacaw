# Copy to .env for local development.
# In CI these are injected from GitHub Actions secrets (see .github/workflows/firebase-deploy.yml).
# Both values are Supabase's public/anon config — they ship in the client bundle by design.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
